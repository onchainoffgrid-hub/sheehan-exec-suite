  "mapping_rules": [
    {
      "id": "override_first",
      "note": "crm_source_overrides.json wins over heuristics"
    },
    {
      "id": "customer_files",
      "source_label": "customer",
      "when": {
        "source_contains_any": [
          "Prior-Customers",
          "P1_customers",
          "paypal_customers",
          "AnnMarie_Payments"
        ],
        "or_lifecycle_in": ["Customer", "customer", "Lapsed customer"]
      }
    },
    {
      "id": "inbound_godaddy_form",
      "source_label": "customer_contact_form",
      "when": {
        "source_contains_any": ["GODADDY_CONTACTS", "godaddy", "contact form", "OTHER_INBOUND"],
        "or_type_in": ["godaddy", "other_inbound", "customer_contact_form"]
      }
    },
    {
      "id": "referral_named",
      "source_label": "customer_referral",
      "when": {
        "type_in": ["customer_referral", "referral"],
        "or_has_referrer": true
      }
    },
    {
      "id": "cdd_hoa",
      "source_label": "copycat_list_cdd",
      "when": {
        "source_contains_any": ["cdd-hoa", "cdd_hoa", "CDD"],
        "or_type_in": ["cdd_hoa", "hoa"]
      }
    },
    {
      "id": "copycat_other",
      "source_label": "copycat_list",
      "when": {
        "source_contains_any": [
          "BUYER_CONTACTS_MONDAY",
          "people-enterprise",
          "Fall-Priority-Call-List",
          "ross-vesta"
        ],
        "or_type_in": ["ross_peer", "ross_checkin", "corporate", "festival", "daycare"]
      }
    },
    {
      "id": "university",
      "source_label": "university",
      "when": {
        "source_contains_any": ["JU_PEER", "university", "PTA campus"],
        "or_type_in": ["university", "pta"]
      }
    },
    {
      "id": "senior_form",
      "source_label": "senior_form",
      "when": {
        "source_contains_any": ["PHONE_TAP_URLS", "senior cold forms", "Brookdale"],
        "or_type_in": ["senior_form", "senior"]
      }
    },
    {
      "id": "school_research",
      "source_label": "school_research",
      "when": {
        "source_contains_any": [
          "school-lane-research",
          "expand-goddard",
          "ivybrook",
          "archive-schools",
          "SUMMER_SCHOLARS"
        ],
        "or_type_in": [
          "school",
          "montessori",
          "homeschool_coop",
          "campus",
          "goddard",
          "ivybrook",
          "summer_scholars"
        ]
      }
    },
    {
      "id": "calendar_only",
      "source_label": "calendar",
      "when": {
        "source_contains_any": ["calendar_attendee", "calendar", "CALENDAR"]
      }
    },
    {
      "id": "gmail_only",
      "source_label": "gmail_harvest",
      "when": {
        "source_contains_any": ["gmail", "Gmail", "EMAIL_HARVEST"]
      }
    },
    {
      "id": "drive_only",
      "source_label": "drive_prior",
      "when": {
        "source_contains_any": ["drive_prior", "Google Drive", "drive/"]
      }
    },
    {
      "id": "fallback",
      "source_label": "unknown",
      "when": {}
    }
  ],
  "filter_chip_priority": [
